# Copy this file to .env.local and fill in at least one key.

# OpenAI (the default). Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude (optional, pick it under the search bar). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini (optional, free tier, no card needed). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
